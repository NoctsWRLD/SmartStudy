# Cloudinary environment variables
# 1. Register at https://cloudinary.com (free, no credit card)
# 2. In Cloudinary dashboard: Settings → Upload → Add upload preset → set to "Unsigned"
# 3. Copy your Cloud Name and Upload Preset Name below
# 4. Rename this file to .env (and add .env to .gitignore!)
# 5. In Vercel: Project Settings → Environment Variables → add both

VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_here
