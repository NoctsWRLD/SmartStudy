# Firebase Web app configuration. Copy this file to .env.local and fill in the
# values from Firebase Console → Project settings → Your apps.
# These browser values are public; access control must be enforced by Firebase
# Security Rules. Never put service account credentials in a VITE_ variable.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_web_app_id
